# Local development defaults. Set credentials for your PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5432/myapp
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

CKAN_BASE_URL=https://data.gov.hr/ckan
CKAN_DATASET_ID=slobodna-radna-mjesta-po-zupanijama-u-rh-i-eu
CKAN_TIMEOUT=15

HZZ_FEED_TIMEOUT=15
HZZ_FEED_MAX_BYTES=5242880
# Reject a feed that shrinks below this share of its last successful item count.
HZZ_MIN_RETAINED_RATIO=0.5

# Optional dedicated PostgreSQL database for ORM integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foihireloom_test
