# Local development defaults. Set credentials for your PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5432/myapp
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

CKAN_BASE_URL=https://data.gov.hr/ckan
CKAN_DATASET_ID=slobodna-radna-mjesta-po-zupanijama-u-rh-i-eu
CKAN_TIMEOUT=15

HZZ_FEED_TIMEOUT=15
HZZ_FEED_MAX_BYTES=5242880
# Reject a feed that shrinks below this share of its last successful item count.
HZZ_MIN_RETAINED_RATIO=0.5
# Search results warn about counties whose feeds last succeeded longer ago than this.
HZZ_STALE_AFTER_HOURS=6

# Job detail pages: one request at a time with this pause, at most BATCH_SIZE per run.
HZZ_PAGE_TIMEOUT=15
HZZ_PAGE_MAX_BYTES=2097152
HZZ_PAGE_DELAY_SECONDS=1
HZZ_PAGE_BATCH_SIZE=500
# Retry an unavailable or failed page after this long.
HZZ_PAGE_RETRY_HOURS=24
# Stop a run after this many failed downloads in a row, e.g. while HZZ is down.
HZZ_PAGE_MAX_CONSECUTIVE_FAILURES=5

# MCP server transport: stdio for local clients, http for Streamable HTTP at http://MCP_HOST:MCP_PORT/MCP_PATH.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Extra host names allowed in the Host header, comma-separated (e.g. a tunnel domain).
MCP_ALLOWED_HOSTS=

# Optional dedicated PostgreSQL database for ORM integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foihireloom_test
